# Xserver のアクセス制限(Basic認証)。旧 analyze.nnts.jp と同じ設定を引き継ぐ
AuthUserFile "/home/xs684527/nnts.jp/htpasswd/analyze.nnts.jp/.htpasswd"
AuthName "Member Site"
AuthType BASIC
require valid-user

# ディレクトリ一覧を出さない
Options -Indexes

# 設定・説明ファイルや隠しファイルを公開しない
<FilesMatch "^(\.|CLAUDE\.md$|README|.*\.(md|sql|sh|log|db)$)">
    Require all denied
</FilesMatch>

# 検索エンジンに載せない
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
